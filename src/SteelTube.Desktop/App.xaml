<Application x:Class="SteelTube.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SteelTube.Desktop.ViewModels"
             xmlns:views="clr-namespace:SteelTube.Desktop.Views"
             xmlns:common="clr-namespace:SteelTube.Desktop.Common">
    <Application.Resources>
        <ResourceDictionary>

            <common:StringToVisibilityConverter x:Key="StringToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <common:InverseBooleanConverter x:Key="InverseBool" />
            <common:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <!-- SRS 9.1: large controls, clear labels, minimal mandatory fields. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="HeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,8,0,4" />
                <Setter Property="Foreground" Value="#555555" />
            </Style>
            <Style x:Key="ErrorBanner" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B00020" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SuccessBanner" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#1B7A34" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="MinWidth" Value="110" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeight" Value="32" />
            </Style>

            <!-- ViewModel -> View mapping (SAD 48 MVVM): ContentControl picks the
                 right view automatically from the type of CurrentViewModel. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CurrentStockViewModel}">
                <views:CurrentStockView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StockMovementViewModel}">
                <views:StockMovementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PartnersViewModel}">
                <views:PartnersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogueViewModel}">
                <views:CatalogueView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConverterViewModel}">
                <views:ConverterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SynchronizationViewModel}">
                <views:SynchronizationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
