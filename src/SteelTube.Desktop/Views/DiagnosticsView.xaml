<UserControl x:Class="SteelTube.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Diagnostics" Style="{StaticResource HeaderText}" />
            <Button Grid.Column="1" Content="Run Check" Command="{Binding RunCheckCommand}" VerticalAlignment="Top" />
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBanner}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}" />

        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <UniformGrid Columns="2" Margin="0,8,0,16">
                <Border Background="#F5F7FA" CornerRadius="6" Padding="16" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Database integrity" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Result.SqliteIntegrityOk, StringFormat={}{0}}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#F5F7FA" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Foreign key integrity" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Result.ForeignKeyIntegrityOk, StringFormat={}{0}}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#F5F7FA" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Duplicate materials" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Result.DuplicateTubeSpecificationGroups}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#F5F7FA" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Duplicate catalogue entries" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Result.DuplicateCatalogueEntryGroups}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Inventory projection" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,12"
                       Text="Compares each material's stored stock total against what summing its full operation history produces (SAD §22). These should always match." />

            <DataGrid ItemsSource="{Binding Mismatches}" MaxHeight="220"
                      Visibility="{Binding HasMismatches, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Diameter (mm)" Binding="{Binding DiameterMm}" Width="120" />
                    <DataGridTextColumn Header="Thickness (mm)" Binding="{Binding ThicknessMm}" Width="120" />
                    <DataGridTextColumn Header="Stored (m)" Binding="{Binding StoredQuantityLengthMeters}" Width="120" />
                    <DataGridTextColumn Header="Computed (m)" Binding="{Binding ComputedQuantityLengthMeters}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No mismatches found." Foreground="#1B7A34" FontWeight="SemiBold" Margin="0,4,0,0"
                       Visibility="{Binding HasMismatches, Converter={StaticResource InverseBoolToVisibility}}" />

            <Button Content="Repair Projection" Command="{Binding RepairCommand}" Margin="0,16,0,0"
                    Background="#B00020" Foreground="White"
                    Visibility="{Binding HasMismatches, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
