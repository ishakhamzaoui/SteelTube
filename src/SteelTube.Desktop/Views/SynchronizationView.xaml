<UserControl x:Class="SteelTube.Desktop.Views.SynchronizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Synchronize" Style="{StaticResource HeaderText}" />
            <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"
                       Text="Exchange stock movements with another SteelTube device via a file (USB drive, shared folder, etc.). Nothing is written until you review and confirm." />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBanner}"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}" />

            <Border Background="#F5F7FA" CornerRadius="6" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Export" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,4,0,12"
                               Text="Saves every local operation to a file you can send to another device." />
                    <Button Content="Export to File..." Command="{Binding ExportCommand}" />
                </StackPanel>
            </Border>

            <Border Background="#FDF6EC" CornerRadius="6" Padding="20">
                <StackPanel>
                    <TextBlock Text="Import" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,4,0,12"
                               Text="Choose a file exported from another device. You'll see a preview before anything changes." />
                    <Button Content="Choose File..." Command="{Binding ChooseFileCommand}" />
                    <TextBlock Text="{Binding SelectedFileName}" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                        <Rectangle Height="1" Fill="#DDDDDD" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Source device" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Preview.SourceDeviceName}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Created" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Preview.CreatedAtUtc, StringFormat={}{0:g}}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3" Margin="0,16,0,16">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="New operations" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Preview.NewOperationsCount}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Already known" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Preview.AlreadyKnownCount}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Potential negative stock" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Preview.PotentialNegativeStockCount}" FontSize="24" FontWeight="Bold" Foreground="#B00020" />
                            </StackPanel>
                        </UniformGrid>

                        <DataGrid ItemsSource="{Binding AffectedMaterials}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Diameter (mm)" Binding="{Binding DiameterMm}" Width="120" />
                                <DataGridTextColumn Header="Thickness (mm)" Binding="{Binding ThicknessMm}" Width="120" />
                                <DataGridTextColumn Header="Current (m)" Binding="{Binding CurrentQuantityLengthMeters, StringFormat={}{0:0.###}}" Width="110" />
                                <DataGridTextColumn Header="Change (m)" Binding="{Binding DeltaLengthMeters, StringFormat={}{0:+0.###;-0.###}}" Width="110" />
                                <DataGridTextColumn Header="Resulting (m)" Binding="{Binding ResultingQuantityLengthMeters, StringFormat={}{0:0.###}}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Apply Synchronization" Command="{Binding ApplyCommand}" Margin="0,16,0,0"
                                Background="#1B7A34" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
