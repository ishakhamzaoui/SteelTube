<UserControl x:Class="SteelTube.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Data" Style="{StaticResource HeaderText}" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBanner}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}" />

        <Border Background="#F5F7FA" CornerRadius="6" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Backup" FontSize="17" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,4,0,12"
                           Text="Creates a verified snapshot of the database. Backups are stored under %PROGRAMDATA%\SteelTube\Backups." />
                <Button Content="Create Backup" Command="{Binding CreateBackupCommand}" />
                <TextBlock Text="{Binding LastBackupPath}" Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Background="#FDF6EC" CornerRadius="6" Padding="20">
            <StackPanel>
                <TextBlock Text="Restore" FontSize="17" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,4,0,12"
                           Text="Replaces all current data with a chosen backup file. Your current data is backed up automatically first, and SteelTube restarts afterward." />
                <Button Content="Choose Backup File and Restore..." Command="{Binding ChooseAndRestoreCommand}" />
                <Button Content="Restart SteelTube Now" Command="{Binding RestartNowCommand}"
                        Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}"
                        Background="#B00020" Foreground="White" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
