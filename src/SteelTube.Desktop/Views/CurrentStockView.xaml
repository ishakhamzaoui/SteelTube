<UserControl x:Class="SteelTube.Desktop.Views.CurrentStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Current Stock" Style="{StaticResource HeaderText}" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <!-- SRS 9.3: grouped by Diameter + Thickness; total length is the quantity that matters,
             not individual piece lengths. -->
        <DataGrid ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Diameter (mm)" Binding="{Binding DiameterMm}" Width="140" />
                <DataGridTextColumn Header="Thickness (mm)" Binding="{Binding ThicknessMm}" Width="140" />
                <DataGridTextColumn Header="Stock Length (m)" Binding="{Binding QuantityLengthMeters, StringFormat={}{0:0.###}}" Width="160" />
                <DataGridTextColumn Header="Weight (kg)" Binding="{Binding QuantityWeightKilograms, StringFormat={}{0:0.###}}" Width="140" />
                <DataGridTemplateColumn Header="" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Negative stock -- review" Foreground="#B00020" FontWeight="SemiBold"
                                       Visibility="{Binding IsNegative, Converter={StaticResource BoolToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
