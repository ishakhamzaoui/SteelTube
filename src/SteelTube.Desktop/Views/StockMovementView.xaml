<UserControl x:Class="SteelTube.Desktop.Views.StockMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderText}" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBanner}"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}" />

            <TextBlock Text="Diameter (mm)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding DiameterMm, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Thickness (mm)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}" />

            <!-- SRS 7.4: Quantity by Length / Weight toggle. -->
            <TextBlock Text="Quantity by" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Length" IsChecked="{Binding UseWeightInput, Converter={StaticResource InverseBool}}" Margin="0,0,20,0" VerticalAlignment="Center" />
                <RadioButton Content="Weight" IsChecked="{Binding UseWeightInput}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Visibility="{Binding UseWeightInput, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Length (m)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding LengthMeters, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Visibility="{Binding UseWeightInput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Weight (kg)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding WeightKilograms, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Text="Provider / Customer (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding PartnerName, UpdateSourceTrigger=PropertyChanged}" />

            <!-- SAD 50: advanced info is collapsed / visually secondary by default. -->
            <Expander Header="Advanced" Margin="0,16,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Number of pieces (optional, informational only)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PieceCount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Operation date (defaults to today)" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding OperationDate}" Width="220" HorizontalAlignment="Left" />

                    <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <Button Content="{Binding SubmitLabel}" Command="{Binding SubmitCommand}" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
