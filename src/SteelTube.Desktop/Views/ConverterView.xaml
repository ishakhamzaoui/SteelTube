<UserControl x:Class="SteelTube.Desktop.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Converter" Style="{StaticResource HeaderText}" />
        <TextBlock Text="Convert between length and weight using the weight catalogue. This does not change stock."
                   TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBanner}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}" />

        <TextBlock Text="Diameter (mm)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding DiameterMm, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Thickness (mm)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Length (m)" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding LengthMeters, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Calculate Weight ->" Command="{Binding CalculateWeightCommand}" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Text="Weight (kg)" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding WeightKilograms, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Calculate Length ->" Command="{Binding CalculateLengthCommand}" Margin="12,0,0,0" />
        </Grid>
    </StackPanel>
</UserControl>
