<UserControl x:Class="SteelTube.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="History" Style="{StaticResource HeaderText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

            <WrapPanel Margin="0,0,0,12">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Diameter (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DiameterMm, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Thickness (mm)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Partner" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PartnerName, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding OperationTypes}" SelectedItem="{Binding SelectedOperationType}" MinWidth="140" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding DateFrom}" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding DateTo}" Width="140" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <Button Content="Search" Command="{Binding SearchCommand}" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding OperationDate, StringFormat={}{0:d}}" Width="100" />
                <DataGridTextColumn Header="Type" Binding="{Binding OperationType}" Width="130" />
                <DataGridTextColumn Header="Diameter (mm)" Binding="{Binding DiameterMm}" Width="110" />
                <DataGridTextColumn Header="Thickness (mm)" Binding="{Binding ThicknessMm}" Width="110" />
                <DataGridTextColumn Header="Change (m)" Binding="{Binding SignedLengthMeters, StringFormat={}{0:+0.###;-0.###}}" Width="100" />
                <DataGridTextColumn Header="Weight (kg)" Binding="{Binding WeightKilograms, StringFormat={}{0:0.###}}" Width="100" />
                <DataGridTextColumn Header="Pieces" Binding="{Binding PieceCount}" Width="70" />
                <DataGridTextColumn Header="Partner" Binding="{Binding PartnerName}" Width="140" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
